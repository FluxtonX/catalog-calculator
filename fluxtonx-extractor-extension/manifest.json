{
  "manifest_version": 3,
  "name": "Catalog Calculator Extractor",
  "version": "1.0.0",
  "description": "Export your track catalog, streams, and royalty data from distribution companies to the Catalog Calculator.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Catalog Calculator Extractor",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*", "file:///*"],
      "js": ["scripts/content.js"]
    }
  ]
}
